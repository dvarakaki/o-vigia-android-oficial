<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber se a rede é limitada antes de baixar o pacote de tradução (dezenas de MB). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Vibração com força escolhida pelo jogador (o toque de tecla do sistema não deixa regular). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".OVigiaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OVigia">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OVigia.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android 12 e anteriores: o AppCompat guarda o idioma escolhido no app e o reaplica ao abrir. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
