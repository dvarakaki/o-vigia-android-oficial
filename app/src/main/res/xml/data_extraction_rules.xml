<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Só as preferências do aparelho (vibração, tela ligada) acompanham o
  jogador; a conta e os dados dele moram na API do O Vigia e voltam ao entrar de novo.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="settings.json" />
    </device-transfer>
</data-extraction-rules>
