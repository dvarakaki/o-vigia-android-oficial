<?xml version="1.0" encoding="utf-8"?>
<!-- Host único: o fundo espacial fica aqui e as telas (fragments) passam por cima dele. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_galaxy" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_main" />

    <!--
      Conquistas: o cartão da comemoração fica por cima de qualquer tela, e só
      é inflado quando a primeira conquista cai — ver
      com.ovigia.app.ui.achievements.AchievementStage.
    -->
    <ViewStub
        android:id="@+id/achievementStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/view_achievement_stage" />

    <!--
      Abertura: o palco da splash só é inflado no primeiro desenho e sai da
      hierarquia quando a cena acaba — ver com.ovigia.app.ui.splash.SplashStage.
    -->
    <ViewStub
        android:id="@+id/splashStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/view_splash_stage" />

</FrameLayout>
