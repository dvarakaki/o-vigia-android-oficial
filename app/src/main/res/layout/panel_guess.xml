<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Widget.OVigia.SpeechPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="64dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/answer_intro"
            android:textAppearance="@style/TextAppearance.OVigia.Label" />

        <ImageView
            android:id="@+id/imageGuess"
            android:layout_width="@dimen/avatar_large"
            android:layout_height="@dimen/avatar_large"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_character_placeholder" />

        <TextView
            android:id="@+id/tvGuessName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.OVigia.Body"
            android:textStyle="bold"
            tools:text="Wolverine" />

        <!-- Raridade do chute: quanto menos conhecido, mais raro. -->
        <TextView
            android:id="@+id/tvGuessRarity"
            style="@style/Widget.OVigia.RarityChip"
            android:layout_marginTop="8dp"
            android:visibility="invisible"
            tools:text="@string/rarity_legendary"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSim"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_sim"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnNao"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/btn_nao"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
