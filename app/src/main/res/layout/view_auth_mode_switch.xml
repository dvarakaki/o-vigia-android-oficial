<?xml version="1.0" encoding="utf-8"?>
<!--
  Seletor Entrar / Criar conta (ver com.ovigia.app.ui.auth.AuthModeSwitch): um
  trilho em pílula com a opção escolhida marcada por uma pílula azul que desliza
  de um lado para o outro por baixo dos rótulos.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:background="@drawable/bg_mode_switch_track"
    tools:padding="4dp"
    tools:parentTag="android.widget.FrameLayout">

    <View
        android:id="@+id/indicator"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_mode_switch_indicator"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabSignIn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_mode_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconSignIn"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/labelSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="@string/auth_mode_sign_in"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSignUp"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/ripple_mode_tab"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconSignUp"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person_add"
                app:tint="@color/white_50" />

            <TextView
                android:id="@+id/labelSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:text="@string/auth_mode_sign_up"
                android:textColor="@color/white_50"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</merge>
