<?xml version="1.0" encoding="utf-8"?>
<!--
  Conquista na lista do perfil: o emblema dela (dourado quando desbloqueada,
  apagado quando não), o nome, como conseguir e o progresso. O selo de certo no
  canto do emblema só aparece nas que já caíram.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <FrameLayout
        android:id="@+id/iconFrame"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_achievement_icon"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/imageIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_trophy"
            app:tint="@color/vigia_gold"
            tools:src="@drawable/ic_ach_shield" />

        <ImageView
            android:id="@+id/imageCheck"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_achievement_check"
            android:importantForAccessibility="no"
            android:padding="3dp"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="@color/vigia_gold"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Vingadores, avante!" />

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/white_70"
                android:textSize="13sp"
                tools:text="3 / 5" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white_70"
            android:textSize="13sp"
            tools:text="Desbloqueie 5 Vingadores." />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            app:indicatorColor="@color/vigia_gold"
            app:indicatorTrackGapSize="0dp"
            app:trackColor="@color/white_10"
            app:trackCornerRadius="3dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="5dp"
            tools:progress="60" />
    </LinearLayout>
</LinearLayout>
