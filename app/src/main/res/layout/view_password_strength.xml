<?xml version="1.0" encoding="utf-8"?>
<!--
  Verificação da senha nova, logo abaixo do campo (ver
  com.ovigia.app.ui.auth.PasswordStrengthView): a barra de força com o rótulo
  ("Fraca", "Quase lá", "Forte" — verde quando forte) e uma linha por exigência,
  cada uma com o disco que vira um certo dourado quando é cumprida.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_strength_track"
            android:clipChildren="true"
            android:importantForAccessibility="no">

            <View
                android:id="@+id/strengthFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_strength_fill"
                android:scaleX="0" />

            <View
                android:id="@+id/strengthShine"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/bg_strength_shine" />
        </FrameLayout>

        <!-- O rótulo muda sozinho com a força: o TalkBack lê a mudança. -->
        <TextView
            android:id="@+id/tvStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:accessibilityLiveRegion="polite"
            android:minWidth="64dp"
            android:gravity="end"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Quase lá"
            tools:textColor="@color/vigia_gold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ruleLength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/discLength"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_rule_disc"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/checkLength"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleX="0"
                android:scaleY="0"
                android:src="@drawable/ic_check"
                app:tint="@color/vigia_space" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvRuleLength"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:textSize="13sp"
            tools:text="Pelo menos 8 caracteres" />

        <!-- Quantos já foram: some quando o mínimo é alcançado (o certo diz o resto). -->
        <TextView
            android:id="@+id/tvLengthCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textColor="@color/white_50"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="5/8" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ruleSpecial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/discSpecial"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_rule_disc"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/checkSpecial"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleX="0"
                android:scaleY="0"
                android:src="@drawable/ic_check"
                app:tint="@color/vigia_space" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvRuleSpecial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:text="@string/password_rule_special"
            android:textSize="13sp" />
    </LinearLayout>
</merge>
