<?xml version="1.0" encoding="utf-8"?>
<!--
  Verificação da senha nova, logo abaixo do campo (ver
  com.ovigia.app.ui.auth.PasswordStrengthView): o medidor em segmentos com o
  rótulo ("Fraca", "Quase lá", "Forte") e uma linha por exigência, cada uma com
  o anel que se enche de verde e desenha o certo quando é cumprida.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.ovigia.app.ui.auth.StrengthMeterView
            android:id="@+id/meter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- O rótulo muda sozinho com a força: o TalkBack lê a mudança. -->
        <TextView
            android:id="@+id/tvStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="end"
            android:minWidth="72dp"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Quase lá"
            tools:textColor="@color/vigia_gold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ruleLength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/markLength"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvRuleLength"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:textSize="13sp"
            tools:text="Pelo menos 8 caracteres" />

        <!-- Quantos já foram: some quando o mínimo é alcançado (o certo diz o resto). -->
        <TextView
            android:id="@+id/tvLengthCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textColor="@color/white_50"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="5/8" />
    </LinearLayout>

    <!-- Mesma forma da linha de cima (anel em ImageView), para as duas animarem igual. -->
    <LinearLayout
        android:id="@+id/ruleSpecial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/markSpecial"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvRuleSpecial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:text="@string/password_rule_special"
            android:textSize="13sp" />
    </LinearLayout>
</merge>
