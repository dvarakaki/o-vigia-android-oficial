<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de um amigo: banner + foto, @usuario, bio, título, números, conquistas
  e heróis desbloqueados. Mesmo visual do próprio perfil, só leitura.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vigia_space"
    tools:ignore="Overdraw">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bannerFrame"
                android:layout_width="match_parent"
                android:layout_height="@dimen/profile_banner_height">

                <ImageView
                    android:id="@+id/imageBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_galaxy" />

                <View
                    android:id="@+id/bannerTint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_banner_default_tint" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_banner_scrim" />
            </FrameLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/avatar_profile_overlap">

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/screen_margin"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/content_max_width">

                    <FrameLayout
                        android:id="@+id/avatarFrame"
                        android:layout_width="@dimen/avatar_profile"
                        android:layout_height="@dimen/avatar_profile"
                        android:background="@drawable/bg_profile_avatar"
                        android:padding="3dp">

                        <ImageView
                            android:id="@+id/imageAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:padding="@dimen/avatar_icon_padding"
                            android:src="@drawable/ic_person"
                            app:tint="@color/vigia_gold" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:accessibilityHeading="true"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Ana Lima" />

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/vigia_gold"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="\@analima" />

                    <TextView
                        android:id="@+id/tvBio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:visibility="gone"
                        tools:text="Fã da Tempestade."
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textColor="@color/white_50"
                        android:textSize="12sp"
                        tools:text="Atualizado há 5 min" />

                    <!-- Título -->
                    <LinearLayout
                        android:id="@+id/rankCard"
                        style="@style/Widget.OVigia.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_trophy"
                            app:tint="@color/vigia_gold" />

                        <TextView
                            android:id="@+id/tvRank"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.OVigia.Label"
                            tools:text="@string/rank_challenger" />

                        <TextView
                            android:id="@+id/tvWinRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/white_70"
                            android:textSize="13sp"
                            tools:text="Vigia acerta 67%" />
                    </LinearLayout>

                    <!-- Números -->
                    <LinearLayout
                        android:id="@+id/statsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/statGames"
                            layout="@layout/item_profile_stat" />

                        <Space
                            android:layout_width="@dimen/gap"
                            android:layout_height="0dp" />

                        <include
                            android:id="@+id/statPlayerWins"
                            layout="@layout/item_profile_stat" />

                        <Space
                            android:layout_width="@dimen/gap"
                            android:layout_height="0dp" />

                        <include
                            android:id="@+id/statHeroes"
                            layout="@layout/item_profile_stat" />
                    </LinearLayout>

                    <!-- Troca de heróis: o que dá para trocar e a sugestão da vez. -->
                    <LinearLayout
                        android:id="@+id/tradeCard"
                        style="@style/Widget.OVigia.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap"
                        android:background="@drawable/bg_card_catalog_progress"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_profile_avatar"
                                android:importantForAccessibility="no">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_swap"
                                    app:tint="@color/vigia_gold" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:accessibilityHeading="true"
                                    android:text="@string/trade_card_title"
                                    android:textAppearance="@style/TextAppearance.OVigia.Label" />

                                <TextView
                                    android:id="@+id/tvTradeBody"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/white_70"
                                    android:textSize="13sp"
                                    tools:text="Ana tem 5 heróis que você não tem. Você tem 3 que ela não tem." />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Sugestão: o herói do amigo que mais vale pedir. -->
                        <LinearLayout
                            android:id="@+id/tradeSuggestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_card_alternative"
                            android:baselineAligned="false"
                            android:focusable="true"
                            android:foreground="@drawable/ripple_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="10dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/imageSuggestion"
                                android:layout_width="48dp"
                                android:layout_height="64dp"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/ShapeAppearance.OVigia.TradeThumb"
                                tools:src="@drawable/ic_character_placeholder" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/trade_suggestion_label"
                                    android:textColor="@color/white_70"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvSuggestionName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    tools:text="Homem-Aranha" />

                                <TextView
                                    android:id="@+id/tvSuggestionReason"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="2"
                                    android:textColor="@color/vigia_gold"
                                    android:textSize="13sp"
                                    tools:text="Fecha “Vingadores, avante!”" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/white_70" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnProposeTrade"
                            style="@style/Widget.OVigia.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/trade_propose" />

                        <TextView
                            android:id="@+id/tvTradeHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/trade_hint_pick"
                            android:textColor="@color/white_50"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Conquistas -->
                    <LinearLayout
                        android:id="@+id/achievementsCard"
                        style="@style/Widget.OVigia.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/gap"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:accessibilityHeading="true"
                                android:text="@string/achievements_title"
                                android:textAppearance="@style/TextAppearance.OVigia.Label" />

                            <TextView
                                android:id="@+id/tvAchievementsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_count_pill"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="2dp"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="4 / 13" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/achievementsList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />

                        <Button
                            android:id="@+id/btnAllAchievements"
                            style="@style/Widget.OVigia.TextAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:icon="@drawable/ic_chevron_right"
                            app:iconGravity="end"
                            app:iconTint="@color/vigia_gold"
                            tools:text="Ver todas (13)"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Heróis desbloqueados -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvHeroesTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/friend_profile_heroes_title"
                            android:textAppearance="@style/TextAppearance.OVigia.Label" />

                        <TextView
                            android:id="@+id/tvHeroesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_count_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroesEmpty"
                        style="@style/Widget.OVigia.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/friend_profile_heroes_empty"
                        android:textColor="@color/white_70"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <!-- Grade de cartas, montada em código. -->
                    <LinearLayout
                        android:id="@+id/heroesGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="-6dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/btnAllHeroes"
                        style="@style/Widget.OVigia.TextAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        app:icon="@drawable/ic_chevron_right"
                        app:iconGravity="end"
                        app:iconTint="@color/vigia_gold"
                        tools:text="Ver todos os 42 heróis"
                        tools:visibility="visible" />

                    <Button
                        android:id="@+id/btnRemoveFriend"
                        style="@style/Widget.OVigia.Button.Danger"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:text="@string/friend_profile_remove" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fundo da barra de status: aparece conforme o banner sai de cena. -->
    <View
        android:id="@+id/statusScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@color/vigia_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        style="@style/Widget.OVigia.IconButton.Scrim"
        android:layout_margin="@dimen/bar_margin"
        android:contentDescription="@string/cd_back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Não carregou (sem rede, ou não são mais amigos). -->
    <LinearLayout
        android:id="@+id/errorState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white_70"
            android:textSize="15sp"
            tools:text="@string/friends_error_offline" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="32dp"
            android:text="@string/btn_retry" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/vigia_gold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
