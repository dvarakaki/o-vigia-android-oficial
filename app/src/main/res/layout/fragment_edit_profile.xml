<?xml version="1.0" encoding="utf-8"?>
<!-- Edição do perfil: banner, foto, dados (nome, bio, e-mail), senha e exclusão da conta. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vigia_space"
    tools:ignore="Overdraw">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner: toque para trocar ou remover. -->
            <FrameLayout
                android:id="@+id/bannerContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/profile_banner_height"
                android:contentDescription="@string/edit_cd_change_banner"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/imageBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_galaxy" />

                <View
                    android:id="@+id/bannerTint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_banner_default_tint" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_banner_scrim" />

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.OVigia.IconButton.Scrim"
                    android:layout_gravity="start|top"
                    android:layout_margin="@dimen/bar_margin"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal|top"
                    android:layout_marginTop="@dimen/bar_margin"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="6"
                    android:text="@string/cd_edit_profile"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="64dp"
                    android:background="@drawable/bg_chip_scrim"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_camera" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/edit_change_banner"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Margem negativa aqui (e não na foto): o container sobe sobre o banner e nada é recortado. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/avatar_profile_overlap">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/screen_margin"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/content_max_width">

                    <!-- Foto: toque para trocar ou remover. -->
                    <FrameLayout
                        android:id="@+id/avatarContainer"
                        android:layout_width="@dimen/avatar_profile"
                        android:layout_height="@dimen/avatar_profile"
                        android:contentDescription="@string/edit_cd_change_photo"
                        android:focusable="true">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_profile_avatar"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="3dp">

                            <ImageView
                                android:id="@+id/imageAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:padding="@dimen/avatar_icon_padding"
                                android:src="@drawable/ic_person"
                                app:tint="@color/vigia_gold" />
                        </FrameLayout>

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="end|bottom"
                            android:background="@drawable/bg_camera_badge"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/ic_camera" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/edit_images_hint"
                        android:textColor="@color/white_70"
                        android:textSize="13sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/imageProgress"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:indeterminate="true"
                        android:visibility="invisible"
                        app:indicatorColor="@color/vigia_gold"
                        app:trackColor="@color/white_10"
                        app:trackCornerRadius="2dp" />

                    <!-- Dados -->
                    <TextView
                        style="@style/Widget.OVigia.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/edit_section_profile" />

                    <LinearLayout
                        style="@style/Widget.OVigia.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/nameLayout"
                            style="@style/Widget.OVigia.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/auth_hint_name"
                            app:counterEnabled="true"
                            app:counterMaxLength="40">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="name"
                                android:imeOptions="actionNext"
                                android:inputType="textPersonName|textCapWords"
                                android:maxLength="40"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/bioLayout"
                            style="@style/Widget.OVigia.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:hint="@string/edit_hint_bio"
                            app:counterEnabled="true"
                            app:counterMaxLength="120">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="top"
                                android:importantForAutofill="no"
                                android:inputType="textMultiLine|textCapSentences"
                                android:maxLength="120"
                                android:maxLines="4"
                                android:minLines="2" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/emailLayout"
                            style="@style/Widget.OVigia.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:hint="@string/auth_hint_email">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="emailAddress"
                                android:imeOptions="actionDone"
                                android:inputType="textEmailAddress"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Só aparece quando o e-mail foi alterado. -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/emailPasswordLayout"
                            style="@style/Widget.OVigia.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/edit_hint_current_password"
                            android:visibility="gone"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/white_70"
                            app:helperText="@string/edit_email_password_helper"
                            tools:visibility="visible">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmailPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="password"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Button
                            android:id="@+id/btnSaveProfile"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:text="@string/edit_save_profile" />
                    </LinearLayout>

                    <!-- Senha -->
                    <TextView
                        style="@style/Widget.OVigia.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_section_password" />

                    <LinearLayout
                        style="@style/Widget.OVigia.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/currentPasswordLayout"
                            style="@style/Widget.OVigia.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/edit_hint_current_password"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/white_70">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCurrentPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="password"
                                android:imeOptions="actionNext"
                                android:inputType="textPassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/newPasswordLayout"
                            style="@style/Widget.OVigia.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/edit_hint_new_password"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/white_70">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNewPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:importantForAutofill="no"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- A senha nova segue a mesma regra do cadastro, conferida ao vivo. -->
                        <com.ovigia.app.ui.auth.PasswordStrengthView
                            android:id="@+id/newPasswordStrength"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:paddingHorizontal="6dp" />

                        <Button
                            android:id="@+id/btnChangePassword"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:text="@string/edit_change_password" />
                    </LinearLayout>

                    <!-- Conta -->
                    <TextView
                        style="@style/Widget.OVigia.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_section_account" />

                    <LinearLayout
                        style="@style/Widget.OVigia.DashboardCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_delete_explanation"
                            android:textColor="@color/white_70"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnDeleteAccount"
                            style="@style/Widget.OVigia.Button.Danger"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="12dp"
                            android:text="@string/edit_delete_account" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fundo da barra de status: aparece conforme o banner sai de cena. -->
    <View
        android:id="@+id/statusScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@color/vigia_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/vigia_gold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
