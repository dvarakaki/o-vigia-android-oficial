<?xml version="1.0" encoding="utf-8"?>
<!-- Catálogo de heróis: progresso, filtro, busca e grade (o cabeçalho recolhe ao rolar). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/bg_galaxy">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.OVigia.IconButton"
                    android:layout_margin="@dimen/bar_margin"
                    android:contentDescription="@string/cd_back"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:layout_gravity="center_horizontal"
                    android:accessibilityHeading="true"
                    android:gravity="center"
                    android:text="@string/catalog_title"
                    android:textAppearance="@style/TextAppearance.OVigia.Title" />
            </FrameLayout>

            <!-- Progresso da coleção -->
            <LinearLayout
                android:id="@+id/progressCard"
                style="@style/Widget.OVigia.DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:background="@drawable/bg_card_catalog_progress"
                android:focusable="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUnlockedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/vigia_gold"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/tvTotalCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="6dp"
                        android:layout_weight="1"
                        android:textColor="@color/white_70"
                        android:textSize="15sp"
                        tools:text="de 173 heróis" />

                    <TextView
                        android:id="@+id/tvPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="2%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:importantForAccessibility="no"
                    android:max="100"
                    app:indicatorColor="@color/vigia_gold"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="@color/white_10"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="8dp"
                    tools:progress="20" />

                <!-- Progresso por raridade: comum, rara, épica e lendária. -->
                <LinearLayout
                    android:id="@+id/rarityRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvRarityCommon"
                        style="@style/Widget.OVigia.RarityCount"
                        tools:text="12/48" />

                    <TextView
                        android:id="@+id/tvRarityRare"
                        style="@style/Widget.OVigia.RarityCount"
                        tools:text="3/99" />

                    <TextView
                        android:id="@+id/tvRarityEpic"
                        style="@style/Widget.OVigia.RarityCount"
                        tools:text="1/50" />

                    <TextView
                        android:id="@+id/tvRarityLegendary"
                        style="@style/Widget.OVigia.RarityCount"
                        tools:text="0/70" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/catalog_how_to_unlock"
                    android:textColor="@color/white_70"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginTop="14dp"
                app:checkedChip="@id/chipUnlocked"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUnlocked"
                    style="@style/Widget.OVigia.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Meus heróis (3)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.OVigia.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Todos (173)" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchLayout"
                style="@style/Widget.OVigia.TextField.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_margin"
                android:layout_marginTop="6dp"
                android:hint="@string/catalog_search_hint"
                app:endIconMode="clear_text"
                app:endIconTint="@color/white_70"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/white_70">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textNoSuggestions"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="18dp"
        android:paddingTop="4dp"
        android:paddingBottom="24dp"
        tools:listitem="@layout/item_catalog_hero" />

    <!-- Nenhum herói desbloqueado ainda (ou busca sem resultado). -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_profile_avatar">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lock"
                app:tint="@color/vigia_gold" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.OVigia.Title"
            tools:text="@string/catalog_empty_title" />

        <TextView
            android:id="@+id/tvEmptyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/white_70"
            android:textSize="15sp"
            tools:text="@string/catalog_empty_body" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="32dp"
            android:text="@string/btn_me_desafie" />
    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="64dp"
        android:indeterminate="true"
        app:indicatorColor="@color/vigia_gold" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
