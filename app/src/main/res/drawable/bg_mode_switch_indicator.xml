<?xml version="1.0" encoding="utf-8"?>
<!--
  A pílula que marca a opção escolhida no seletor Entrar / Criar conta: o azul
  dos botões principais, um pouco mais claro na ponta, com uma borda de brilho.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="@color/vigia_blue_bright"
        android:startColor="@color/vigia_blue" />
    <stroke
        android:width="1dp"
        android:color="@color/white_20" />
    <corners android:radius="22dp" />
</shape>
