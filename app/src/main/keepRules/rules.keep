# Regras do R8 para o O Vigia.
# AGP combina todos os arquivos de src/main/keepRules e entrega ao R8.

# Modelos lidos/escritos via Gson por reflexão (fichas dos personagens, caches em disco,
# roster.json e preferências). Sem isso o R8 renomeia os campos e o JSON deixa de
# casar — e troca Map/List por HashMap/ArrayList, o que apaga a assinatura genérica
# (KeepRulesTest guarda isto). Os dados do jogador na API, a cópia deles no aparelho e
# os arquivos das versões antigas são lidos como árvore JSON: nada disso precisa de regra.
-keep class com.ovigia.app.model.** { <fields>; <init>(); }
-keep class com.ovigia.app.data.roster.RosterCatalog$Document { <fields>; <init>(); }
-keep class com.ovigia.app.data.roster.RosterCatalog$Entry { <fields>; <init>(); }
-keep class com.ovigia.app.settings.SettingsStore$State { <fields>; <init>(); }
-keep class com.ovigia.app.translation.CachedHeroTranslationRepository$Cache { <fields>; <init>(); }
-keepclassmembers enum com.ovigia.app.learning.LearningStore$Outcome { *; }

# Gson: preservar assinaturas genéricas e anotações. No modo completo do R8 a
# assinatura só sobrevive em classes mantidas — por isso as regras de TypeToken.
-keepattributes Signature, *Annotation*, EnclosingMethod, InnerClasses
-keep,allowobfuscation,allowshrinking class com.google.gson.reflect.TypeToken
-keep,allowobfuscation,allowshrinking class * extends com.google.gson.reflect.TypeToken

# Retrofit: tipos genéricos dos métodos da interface.
-keep,allowobfuscation,allowshrinking interface retrofit2.Call
-keep,allowobfuscation,allowshrinking class retrofit2.Response
-keep interface com.ovigia.app.api.CharacterService { *; }

# jsoup (biografia dos personagens): o motor de regex alternativo é opcional e não vai no APK.
-dontwarn com.google.re2j.**
-dontwarn org.jspecify.annotations.**

# Stack traces legíveis no Play Console (com o mapping.txt).
-keepattributes SourceFile, LineNumberTable
-renamesourcefileattribute SourceFile
